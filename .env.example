# Copy to .env and fill in. Only the first block is required to run locally.
# Every service below has a free tier that needs no credit card.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Neon PostgreSQL (https://neon.com). Create a project, then copy both strings
# from "Connect": the pooled one for the app, the direct one for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon Auth. Auth URL: Neon console > Better Auth > Project Info.
NEON_AUTH_BASE_URL=""
# Cookie secret, generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""
# Public address of this app (used in invite emails)
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Optional: each feature switches on when its variables are set
# ---------------------------------------------------------------------------

# Google sign-in (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Razorpay in TEST mode only (https://dashboard.razorpay.com, toggle "Test Mode")
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_PLAN_ID_PRO=""
RAZORPAY_PLAN_ID_TEAM=""

# Email via Gmail SMTP. Needs 2-Step Verification and an App Password:
# https://myaccount.google.com/apppasswords
# Without these, emails are printed to the server console instead.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Upstash Redis for rate limiting (https://console.upstash.com)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# LLMs for the "Ask Tenly" assistant. Set at least one.
# Gemini: https://aistudio.google.com/apikey (create it in a project with NO billing account)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# Groq: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
